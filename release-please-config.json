    },
    "reef-bundle": {
      "release-type": "python",
      "component": "reef-bundle",
      "package-name": "reef-bundle",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true
    },
    "reef-chart": {
      "release-type": "helm",
      "component": "reef-chart",
      "package-name": "reef-chart",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true
    }
  }
}
    